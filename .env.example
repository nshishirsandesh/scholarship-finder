# Firebase Authentication & Cloud Firestore (Live Mode)
# Leave as is or empty to automatically run in Lab Demo Mode with simulated OTP & local personas.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Google Gemini API Key for AI Scholarship Advisor (Online Mode)
# When omitted, the app automatically runs the Grounded Heuristic Conversational Engine offline without failing.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
